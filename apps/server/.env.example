# Game server settings (apps/server/src/config.ts; the full list with every default is in apps/server/README.md,
# "Configuration (environment variables)"). The server reads plain environment variables. Set them in your shell,
# or copy this file to apps/server/.env (gitignored) and start the server with it:
#
#   pnpm --filter @sro/server exec tsx --env-file=.env src/main.ts
#
# Every line below is optional; the values shown are the defaults.

# Network. HOST defaults to 127.0.0.1, or to 0.0.0.0 when NODE_ENV=production: on a shared machine set it to a
# private address (e.g. your Tailscale IP). Registration is open to anyone who can reach the port, so never
# port-forward it to the internet.
# HOST=127.0.0.1
# PORT=7000
# NODE_ENV=production           # serves the built client (apps/game/dist) at / plus /out and /out-opt on PORT
# ALLOWED_ORIGINS=              # extra browser origins, comma-separated, e.g. http://100.64.0.5:5180

# Where things live. Leave them unset to use the repository's own folders (shown); if you change them, use
# absolute paths.
# DATA_DIR=<repo>/work/server       # game.db (created with its migrations on first start) and world-clock.json
# OUT_DIR=<repo>/work/out           # converted assets, served at /out/
# OUT_OPT_DIR=<repo>/work/out-opt   # optimized assets, served at /out-opt/
# GAME_DIST=<repo>/apps/game/dist   # the built client (production)
# WORLD_EXPORT=jangan-fields        # world export folder under OUT_DIR/world/

# Gameplay.
# LEVEL_CAP=20
# CAPACITY=50                   # players in the world
# REGISTER_LIMIT=10             # registrations per IP per hour
# EXP_RATE=1
# SP_RATE=1
# GOLD_RATE=1
# DROP_RATE=1
